@model TaxiLink.UI.Areas.Client.Models.ClientDashboardViewModel
@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Профіль";
}

<style>
    .profile-wrapper {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px 20px 100px 20px; 
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        height: 100vh;
        overflow-y: auto; 
    }

        .profile-wrapper::-webkit-scrollbar {
            width: 0;
        }
    .glass-card {
        background: #1e293b;
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        margin-bottom: 25px;
    }

    .avatar-container {
        position: relative;
        width: 100px;
        height: 100px;
        margin: -70px auto 30px auto;
    }

    .avatar-large {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 4px solid #1e293b;
        box-shadow: 0 0 20px rgba(250, 204, 21, 0.3);
        overflow: hidden;
        background: #334155;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        color: #facc15;
        font-weight: bold;
    }

    .btn-edit-avatar {
        position: absolute;
        bottom: -5px;
        right: -5px;
        background: #facc15;
        color: #0f172a;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 3px solid #1e293b;
        transition: transform 0.2s;
    }

        .btn-edit-avatar:hover {
            transform: scale(1.1);
        }

    .custom-input {
        background: #0f172a;
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #f8fafc;
        border-radius: 10px;
        padding: 12px 15px;
        width: 100%;
        margin-bottom: 15px;
    }

        .custom-input:focus {
            border-color: #facc15;
            outline: none;
        }

    .custom-label {
        color: #94a3b8;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 5px;
        display: block;
    }

    .google-box {
        background: rgba(15, 23, 42, 0.5);
        border-radius: 12px;
        padding: 15px 20px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .switch-custom {
        position: relative;
        display: inline-block;
        width: 46px;
        height: 24px;
    }

        .switch-custom input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider-custom {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #475569;
        transition: .4s;
        border-radius: 34px;
    }

        .slider-custom:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider-custom {
        background-color: #facc15;
    }

        input:checked + .slider-custom:before {
            transform: translateX(22px);
            background-color: #0f172a;
        }

    .save-btn {
        background-color: #facc15;
        color: #0f172a;
        border: none;
        border-radius: 50px;
        padding: 14px 40px;
        font-weight: bold;
        font-size: 1.1rem;
        cursor: pointer;
        width: 100%;
        max-width: 300px;
        transition: opacity 0.2s;
    }

        .save-btn:hover {
            opacity: 0.9;
        }
</style>

<div class="profile-wrapper mt-4">
    <h2 class="text-center fw-bold text-white mb-5">Мій Профіль</h2>

    <form method="post" enctype="multipart/form-data" action="@Url.Action("Profile", "Dashboard", new { area = "Client" })">

        <div class="glass-card mt-4">
            <div class="avatar-container">
                <div class="avatar-large" id="avatarUploadBtn">
                    @if (string.IsNullOrEmpty(Model.User.AvatarPath))
                    {
                        <span id="avatarText">@Model.User.FirstName.Substring(0, 1).ToUpper()</span>
                        <img id="avatarPreview" src="" style="display:none; width:100%; height:100%; object-fit:cover;" />
                    }
                    else
                    {
                        <img id="avatarPreview" src="@Model.User.AvatarPath" style="width:100%; height:100%; object-fit:cover;" />
                    }
                </div>
                <div class="btn-edit-avatar" onclick="document.getElementById('avatarInput').click()">
                    <i class="fas fa-camera"></i>
                </div>
                <input type="file" id="avatarInput" name="AvatarUpload" accept="image/*" style="display:none;" />
            </div>

            <div class="row">
                <div class="col-md-6">
                    <label class="custom-label">Ім'я</label>
                    <input type="text" name="FirstName" class="custom-input" value="@Model.User.FirstName" required />
                </div>
                <div class="col-md-6">
                    <label class="custom-label">Прізвище</label>
                    <input type="text" name="LastName" class="custom-input" value="@Model.User.LastName" />
                </div>
                <div class="col-md-6">
                    <label class="custom-label">Телефон</label>
                    <input type="text" name="PhoneNumber" class="custom-input" value="@Model.User.PhoneNumber" required />
                </div>
                <div class="col-md-6">
                    <label class="custom-label">Email</label>
                    <input type="email" name="Email" class="custom-input" value="@Model.User.Email" />
                </div>
            </div>
        </div>

        <h6 class="fw-bold text-white mb-3 ms-2">Акаунти</h6>
        <div class="glass-card p-0 mb-4 overflow-hidden">
            <div class="google-box">
                <div class="d-flex align-items-center">
                    <div style="background: white; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                        <i class="fa-brands fa-google" style="color: #ea4335; font-size: 1.2rem;"></i>
                    </div>
                    <div class="ms-3">
                        <div class="fw-bold text-white" style="font-size: 1rem;">Google Акаунт</div>
                        <div style="font-size: 0.85rem;" class="fw-bold @(Model.IsGoogleLinked ? "text-success" : "text-muted")">
                            @(Model.IsGoogleLinked ? "Підключено" : "Не підключено")
                        </div>
                    </div>
                </div>
                @if (!Model.IsGoogleLinked)
                {
                    <a href="/Auth/ExternalLogin?provider=Google" class="btn btn-outline-light btn-sm rounded-pill px-3">Підключити</a>
                }
            </div>
        </div>

        <h6 class="fw-bold text-white mb-3 ms-2">Налаштування поїздок</h6>
        <div class="glass-card p-0 mb-5 overflow-hidden">
            <label class="d-flex justify-content-between align-items-center p-3 border-bottom" style="border-color: rgba(255,255,255,0.05) !important; cursor: pointer; margin: 0;">
                <div>
                    <span class="fw-bold text-white">Тиха поїздка</span>
                    <div class="text-muted" style="font-size: 0.8rem;">Водій не буде ініціювати розмову</div>
                </div>
                <div class="switch-custom">
                    <input type="checkbox" name="PrefersSilentRide" value="true" @(Model.User.PrefersSilentRide ? "checked" : "")>
                    <span class="slider-custom"></span>
                </div>
            </label>

            <label class="d-flex justify-content-between align-items-center p-3" style="cursor: pointer; margin: 0;">
                <div>
                    <span class="fw-bold text-white">Без музики</span>
                    <div class="text-muted" style="font-size: 0.8rem;">Вимкнути музику або радіо в авто</div>
                </div>
                <div class="switch-custom">
                    <input type="checkbox" name="PrefersNoMusic" value="true" @(Model.User.PrefersNoMusic ? "checked" : "")>
                    <span class="slider-custom"></span>
                </div>
            </label>
        </div>

        <div class="text-center mb-5">
            <button type="submit" class="save-btn">Зберегти зміни</button>
        </div>
    </form>
</div>

<script>
    document.getElementById('avatarInput').addEventListener('change', function (e) {
        if (this.files && this.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const preview = document.getElementById('avatarPreview');
                const text = document.getElementById('avatarText');
                if(text) text.style.display = 'none';
                preview.src = e.target.result;
                preview.style.display = 'block';
            };
            reader.readAsDataURL(this.files[0]);
        }
    });
</script>