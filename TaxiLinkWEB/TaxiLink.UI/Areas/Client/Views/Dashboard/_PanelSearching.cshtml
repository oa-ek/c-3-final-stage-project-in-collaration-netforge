@model TaxiLink.UI.Areas.Client.Models.ClientDashboardViewModel
<div id="panel-searching" class="floating-panel center-screen d-none">
    <div class="text-center mb-3">
        <i class="fa-solid fa-magnifying-glass" style="font-size: 32px; color: var(--accent);"></i>
    </div>
    <h3 class="text-center fw-bold mb-1">Шукаємо найкращого водія...</h3>
    <p class="text-center text-muted small mb-4">Це займе лише кілька секунд</p>

    <div class="inner-dark-box mb-4">
        <div class="route-dots-line">
            <div class="dot green"></div>
            <div class="text muted" id="search-pickup">Поточне місцезнаходження</div>
        </div>
        <div class="route-dots-line">
            <div class="dot red"></div>
            <div class="text" id="search-dropoff">Завантаження...</div>
        </div>
        <div class="text-center mt-4">
            <h2 class="m-0" style="color: var(--accent); font-weight: 800;"><span id="search-price">0</span> ₴</h2>
        </div>
    </div>

    <button class="btn-cancel-red" id="btn-cancel-search">Скасувати замовлення</button>
</div>